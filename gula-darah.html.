];
let qi = 0, score = 0;
function renderQuiz(){
  const box = document.getElementById('quizBox');
  const pct = Math.round(qi / quiz.length * 100);
  if(qi >= quiz.length){
    const msg = score >= 5 ? 'Pemahamanmu sudah baik. Terus terapkan di rumah.' : 'Baca kembali materi dan tips, lalu coba lagi.';
    box.innerHTML = '<div class="bar" aria-hidden="true"><i style="width:100%"></i></div><div class="card"><p>Skor akhir</p><p class="score">' + score + ' / ' + quiz.length + '</p><p>' + msg + '</p><button class="btn" id="again">Ulangi kuis</button> <button class="btn ghost" id="toMateri">Buka materi</button></div>';
    document.getElementById('again').onclick = () => { qi = 0; score = 0; renderQuiz(); };
    document.getElementById('toMateri').onclick = () => go('materi');
    return;
  }
  const q = quiz[qi];
  box.innerHTML = '<div class="q-meta">Soal ' + (qi+1) + ' dari ' + quiz.length + '</div><div class="bar" aria-hidden="true"><i style="width:' + pct + '%"></i></div><h3>' + q.q + '</h3><div id="opts"></div><div id="fb"></div>';
  const opts = box.querySelector('#opts');
  q.o.forEach((t, i) => {
    const b = document.createElement('button');
    b.className = 'opt'; b.textContent = t;
    b.onclick = () => {
      opts.querySelectorAll('button').forEach((x, j) => { x.disabled = true; if(j === q.a) x.classList.add('right'); });
      if(i === q.a){ score++; } else { b.classList.add('wrong'); }
      const fb = box.querySelector('#fb');
      fb.innerHTML = '<p class="explain"><strong>' + (i === q.a ? 'Benar. ' : 'Belum tepat. ') + '</strong>' + q.e + '</p><button class="btn" id="next">' + (qi === quiz.length-1 ? 'Lihat skor' : 'Soal berikutnya') + '</button>';
      fb.querySelector('#next').onclick = () => { qi++; renderQuiz(); };
    };
    opts.appendChild(b);
  });
}

renderTable(); renderQuiz();
</script>
