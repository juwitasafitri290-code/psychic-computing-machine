<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Kendalikan Gula Darah – Lifestyle Sehat DM Tipe 2</title>
<style>
:root{
  --bg:#FFF5F7; --surface:#FFFFFF; --ink:#3A1722; --muted:#7A5560; --line:#F0D4DB;
  --accent:#C73F6C; --accent-ink:#FFFFFF; --accent-text:#B02F5B; --soft:#FBE3EA;
  --warn:#9A4A0A; --warn-soft:#FFF0DC; --warn-bar:#E08A2E;
  --ok:#1B7A43; --ok-soft:#DDF2E4; --bad:#B3261E; --bad-soft:#FDE4E2; --head:#FBE3EA;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#1B0F14; --surface:#251319; --ink:#F3E9EC; --muted:#BBA4AB; --line:#3C232B;
    --accent:#C73F6C; --accent-ink:#FFFFFF; --accent-text:#F59AB3; --soft:#35192A;
    --warn:#F0B27A; --warn-soft:#3A2412; --warn-bar:#E08A2E;
    --ok:#7BD59B; --ok-soft:#173523; --bad:#FF9C94; --bad-soft:#40181A; --head:#321820;
  }
}
:root[data-theme="dark"]{
  --bg:#1B0F14; --surface:#251319; --ink:#F3E9EC; --muted:#BBA4AB; --line:#3C232B;
  --accent:#C73F6C; --accent-ink:#FFFFFF; --accent-text:#F59AB3; --soft:#35192A;
  --warn:#F0B27A; --warn-soft:#3A2412; --warn-bar:#E08A2E;
  --ok:#7BD59B; --ok-soft:#173523; --bad:#FF9C94; --bad-soft:#40181A; --head:#321820;
}
html{height:100%;scroll-padding-top:env(safe-area-inset-top,0px)}
*,*::before,*::after{box-sizing:border-box}
body{margin:0;min-height:100%;background:var(--bg);color:var(--ink);
  font-family:system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;font-size:16px;line-height:1.55}
h1,h2,h3{line-height:1.2;margin:0 0 .5em}
h1{font-size:clamp(1.8rem,7vw,2.5rem)}
h2{font-size:1.45rem}
h3{font-size:1.05rem}
p{margin:0 0 .9em}
button{font:inherit;color:inherit;cursor:pointer}
:focus-visible{outline:3px solid var(--accent-text);outline-offset:2px}

.shell{max-width:760px;margin:0 auto;padding:0 16px 48px}
nav.tabs{position:sticky;top:env(safe-area-inset-top,0px);z-index:10;background:var(--bg);display:flex;gap:6px;overflow-x:auto;padding:12px 0 10px;scrollbar-width:none}
nav.tabs::-webkit-scrollbar{display:none}
nav.tabs button{flex:none;background:none;border:0;border-radius:999px;padding:8px 14px;color:var(--ink)}
nav.tabs button[aria-selected="true"]{background:var(--accent);color:var(--accent-ink)}

section.page{display:none;padding-top:8px}
section.page.active{display:block}

.hero{background:var(--accent);color:var(--accent-ink);border-radius:20px;padding:26px 22px;margin-bottom:16px}
.hero h1{margin-bottom:.35em}
.hero p{margin-bottom:.7em}
.hero small{display:block;opacity:.92;font-size:.85rem}
.grid{display:grid;gap:12px;grid-template-columns:1fr 1fr;margin-bottom:16px}
@media(max-width:380px){.grid{grid-template-columns:1fr}}
.grid button{text-align:left;background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:16px}
.grid button strong{display:block;margin-bottom:2px}
.grid button span{color:var(--muted);font-size:.88rem}
.note{border-left:4px solid var(--warn-bar);background:var(--warn-soft);color:var(--ink);border-radius:10px;padding:14px 16px;margin:0 0 14px}
.note.bad{border-left-color:var(--bad);background:var(--bad-soft)}
.note strong:first-child{display:block;margin-bottom:4px}

.card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:16px 18px;margin-bottom:14px}
.card h3{margin-bottom:.45em}
.card ul{margin:0;padding-left:1.15em}
.card li{margin-bottom:.4em}
.card li:last-child{margin-bottom:0}
.card p:last-child{margin-bottom:0}
.kv{display:grid;grid-template-columns:auto 1fr;gap:4px 16px;margin:0}
.kv dt{font-weight:700}
.kv dd{margin:0;color:var(--muted)}

/* Checklist */
.lead{color:var(--muted);font-size:.9rem}
.stat{color:var(--muted);font-size:.88rem;margin:6px 0}
.bar{height:8px;background:var(--soft);border-radius:999px;overflow:hidden;margin-bottom:14px}
.bar i{display:block;height:100%;width:0;background:var(--accent);transition:width .3s}
.tablewrap{overflow-x:auto;border:1px solid var(--line);border-radius:12px;background:var(--surface)}
table{border-collapse:collapse;width:100%;min-width:620px}
th,td{border:1px solid var(--line);padding:8px;text-align:center}
th{background:var(--head);font-size:.9rem}
th:first-child,td:first-child{text-align:left;min-width:120px;position:sticky;left:0;background:var(--surface);z-index:1}
th:first-child{background:var(--head)}
td input[type=checkbox]{width:22px;height:22px;accent-color:var(--accent)}
td input[type=number]{width:64px;font:inherit;text-align:center;padding:8px 4px;border-radius:8px;border:1px solid var(--line);background:var(--bg);color:var(--ink)}
td input.ok{border-color:var(--ok);background:var(--ok-soft)}
td input.mid{border-color:var(--warn-bar);background:var(--warn-soft)}
td input.bad{border-color:var(--bad);background:var(--bad-soft)}
.legend{font-size:.85rem;color:var(--muted);margin:10px 0 14px}
.btn{background:var(--accent);color:var(--accent-ink);border:0;border-radius:999px;padding:11px 20px;font-weight:700}
.btn.ghost{background:none;border:1.5px solid var(--line);color:var(--ink)}

/* Kuis */
.q-meta{color:var(--muted);font-size:.88rem;margin-bottom:6px}
.opt{display:block;width:100%;text-align:left;background:var(--surface);border:1.5px solid var(--line);border-radius:12px;padding:14px 16px;margin-bottom:10px}
.opt.right{border-color:var(--ok);background:var(--ok-soft)}
.opt.wrong{border-color:var(--bad);background:var(--bad-soft)}
.opt:disabled{cursor:default;color:inherit}
.explain{color:var(--muted);margin:6px 0 14px}
.score{font-size:3rem;font-weight:700;color:var(--accent-text);margin:0}

ol.refs{padding-left:1.2em;margin:0 0 14px}
ol.refs li{margin-bottom:10px}
.tip{color:var(--muted);font-size:.88rem}
.themebtn{float:right;margin-top:-4px}
@media (prefers-reduced-motion: reduce){*{transition:none!important}}
</style>
</head>
<body>
<div class="shell">
  <nav class="tabs" role="tablist" aria-label="Menu utama">
    <button role="tab" data-tab="beranda" aria-selected="true">Beranda</button>
    <button role="tab" data-tab="materi" aria-selected="false">Materi</button>
    <button role="tab" data-tab="tips" aria-selected="false">Tips</button>
